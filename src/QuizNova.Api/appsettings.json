{
  "JwtSettings": {
    "Issuer": "QuizNova.Api",
    "Audience": "QuizNova.Client",
    "Secret": "CHANGE_ME_32_CHAR_MIN_SECRET_KEY_PLEASE",
    "ExpiryMinutes": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "https://logs-prod-012.grafana.net",
          "credentials": {
            "login": "FROM_ENV",
            "password": "FROM_ENV"
          },
          "labels": [
            { "key": "app", "value": "QuizNova.Api" },
            { "key": "env", "value": "production" }
          ],
          "period": 1,
          "eagerlyEmitFirstEvent": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "QuizNova.Api"
    }
  },
  "AppSettings": {
    "Cors": {
      "PolicyName": "QuizNovaCorsPolicy",
      "AllowedOrigins": [ "http://localhost:4200" ]
    }
  },
  "AllowedHosts": "*"
}
