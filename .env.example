# QuizNova - Environment Variables Template
# Copy this file to .env and fill in your local credentials

# PostgreSQL Configuration
POSTGRES_DB=QuizNova
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# JWT Security
JWT_SECRET=Your_Super_Secret_Key_At_Least_32_Characters_Long
JWT_ISSUER=QuizNova.Api
JWT_AUDIENCE=QuizNova.Client

# MongoDB Configuration
MONGO_USER=admin
MONGO_PASSWORD=your_secure_mongo_password

# Infrastructure
SEQ_PORT=5341
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_me_admin_password
PROMETHEUS_PORT=9090
